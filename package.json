{
  "name": "@lichens-innovation/ts-common",
  "version": "1.28.0",
  "description": "Reusable generic typescript utilities, types, constants, helpers",
  "keywords": [
    "typescript",
    "utilities",
    "utils",
    "helpers",
    "common"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "import": "./dist/excel.js",
      "require": "./dist/excel.cjs",
      "default": "./dist/excel.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs",
      "default": "./dist/csv.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs",
      "default": "./dist/pdf.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs",
      "default": "./dist/web.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "import": "./dist/mime.js",
      "require": "./dist/mime.cjs",
      "default": "./dist/mime.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs",
      "default": "./dist/logger.js"
    },
    "./rjsf": {
      "types": "./dist/rjsf.d.ts",
      "import": "./dist/rjsf.js",
      "require": "./dist/rjsf.cjs",
      "default": "./dist/rjsf.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Lichens-Innovation/ts-common.git"
  },
  "author": "Lichens Innovation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "clean:node": "npx rimraf node_modules bun.lockb",
    "clean:dist": "npx rimraf dist",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "security:check": "npx --yes cve-lite-cli@latest . --fail-on high --ratchet --verbose",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "4.4.0"
  },
  "peerDependencies": {
    "@rjsf/utils": "*",
    "@rjsf/validator-ajv8": "*",
    "ajv-i18n": "*",
    "exceljs": "^4.4.0",
    "i18next": "*",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "mime": "^4.1.0",
    "papaparse": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "react-i18next": "*"
  },
  "peerDependenciesMeta": {
    "@rjsf/utils": {
      "optional": true
    },
    "@rjsf/validator-ajv8": {
      "optional": true
    },
    "ajv-i18n": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    },
    "mime": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv-i18n": "4.2.0",
    "commitlint": "21.2.4",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "exceljs": "4.4.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "i18next": "26.5.11",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "knip": "6.43.0",
    "mime": "4.1.1",
    "npm-package-json-lint": "11.0.0",
    "papaparse": "5.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "react-i18next": "17.1.9",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
