{
  "name": "@lichens-innovation/ts-common",
  "version": "1.25.0",
  "description": "Reusable generic typescript utilities, types, constants, helpers",
  "keywords": [
    "typescript",
    "utilities",
    "utils",
    "helpers",
    "common"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "import": "./dist/excel.js",
      "require": "./dist/excel.cjs",
      "default": "./dist/excel.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs",
      "default": "./dist/csv.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs",
      "default": "./dist/pdf.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs",
      "default": "./dist/web.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "import": "./dist/mime.js",
      "require": "./dist/mime.cjs",
      "default": "./dist/mime.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs",
      "default": "./dist/logger.js"
    },
    "./rjsf": {
      "types": "./dist/rjsf.d.ts",
      "import": "./dist/rjsf.js",
      "require": "./dist/rjsf.cjs",
      "default": "./dist/rjsf.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Lichens-Innovation/ts-common.git"
  },
  "author": "Lichens Innovation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "clean:node": "npx rimraf node_modules bun.lockb",
    "clean:dist": "npx rimraf dist",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "4.4.0"
  },
  "peerDependencies": {
    "@rjsf/utils": "*",
    "@rjsf/validator-ajv8": "*",
    "ajv-i18n": "*",
    "exceljs": "4.4.0",
    "i18next": "*",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "mime": "4.1.0",
    "papaparse": "5.5.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react-i18next": "*"
  },
  "peerDependenciesMeta": {
    "@rjsf/utils": {
      "optional": true
    },
    "@rjsf/validator-ajv8": {
      "optional": true
    },
    "ajv-i18n": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    },
    "mime": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@rjsf/utils": "6.7.1",
    "@rjsf/validator-ajv8": "6.7.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "10.3.5",
    "@types/node": "25.5.0",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "4.1.10",
    "ajv-i18n": "4.2.0",
    "commitlint": "20.5.3",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "exceljs": "4.4.0",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "i18next": "25.10.10",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "knip": "6.29.0",
    "mime": "4.1.0",
    "npm-package-json-lint": "10.4.1",
    "papaparse": "5.5.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "react-i18next": "16.6.6",
    "rimraf": "6.1.3",
    "semantic-release": "24.2.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
