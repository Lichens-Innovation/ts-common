{
  "name": "@lichens-innovation/ts-common",
  "version": "1.13.0",
  "description": "Reusable generic typescript utilities, types, constants, helpers",
  "keywords": [
    "typescript",
    "utilities",
    "utils",
    "helpers",
    "common"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "import": "./dist/excel.js",
      "require": "./dist/excel.cjs",
      "default": "./dist/excel.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs",
      "default": "./dist/csv.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs",
      "default": "./dist/pdf.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs",
      "default": "./dist/web.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "import": "./dist/mime.js",
      "require": "./dist/mime.cjs",
      "default": "./dist/mime.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs",
      "default": "./dist/logger.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": "git@github.com:Lichens-Innovation/ts-common.git",
  "author": "Lichens Innovation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean:node": "npx rimraf node_modules yarn.lock",
    "clean:dist": "npx rimraf dist",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "mime": "^4.1.0",
    "papaparse": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    },
    "mime": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@types/node": "^25.3.5",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "4.0.18",
    "commitlint": "^20.4.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "exceljs": "^4.4.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "mime": "^4.1.0",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
