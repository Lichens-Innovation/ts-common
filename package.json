{
  "name": "@lichens-innovation/ts-common",
  "version": "1.30.0",
  "description": "Reusable generic typescript utilities, types, constants, helpers",
  "keywords": [
    "typescript",
    "utilities",
    "utils",
    "helpers",
    "common"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./excel": {
      "import": {
        "types": "./dist/excel.d.ts",
        "default": "./dist/excel.js"
      },
      "require": {
        "types": "./dist/excel.d.cts",
        "default": "./dist/excel.cjs"
      },
      "default": "./dist/excel.js"
    },
    "./csv": {
      "import": {
        "types": "./dist/csv.d.ts",
        "default": "./dist/csv.js"
      },
      "require": {
        "types": "./dist/csv.d.cts",
        "default": "./dist/csv.cjs"
      },
      "default": "./dist/csv.js"
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      },
      "default": "./dist/pdf.js"
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      },
      "default": "./dist/web.js"
    },
    "./mime": {
      "import": {
        "types": "./dist/mime.d.ts",
        "default": "./dist/mime.js"
      },
      "require": {
        "types": "./dist/mime.d.cts",
        "default": "./dist/mime.cjs"
      },
      "default": "./dist/mime.js"
    },
    "./logger": {
      "import": {
        "types": "./dist/logger.d.ts",
        "default": "./dist/logger.js"
      },
      "require": {
        "types": "./dist/logger.d.cts",
        "default": "./dist/logger.cjs"
      },
      "default": "./dist/logger.js"
    },
    "./rjsf": {
      "import": {
        "types": "./dist/rjsf.d.ts",
        "default": "./dist/rjsf.js"
      },
      "require": {
        "types": "./dist/rjsf.d.cts",
        "default": "./dist/rjsf.cjs"
      },
      "default": "./dist/rjsf.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Lichens-Innovation/ts-common.git"
  },
  "author": "Lichens Innovation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "clean:node": "bunx rimraf node_modules bun.lock",
    "clean:dist": "bunx rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "coding-guide check",
    "lint:ci": "eslint",
    "lint:fix": "eslint --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "bunx cve-lite-cli@latest . --fail-on high --ratchet --verbose",
    "habit:hooks": "coding-guide check --branch main",
    "habit:hooks:full": "coding-guide check",
    "habit:snoozed": "coding-guide snooze --list",
    "lint:exports": "publint"
  },
  "dependencies": {
    "date-fns": "4.4.0"
  },
  "peerDependencies": {
    "@rjsf/utils": "*",
    "@rjsf/validator-ajv8": "*",
    "ajv-i18n": "*",
    "exceljs": "^4.4.0",
    "i18next": "*",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "mime": "^4.1.0",
    "papaparse": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "react-i18next": "*"
  },
  "peerDependenciesMeta": {
    "@rjsf/utils": {
      "optional": true
    },
    "@rjsf/validator-ajv8": {
      "optional": true
    },
    "ajv-i18n": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    },
    "mime": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@lichens-innovation/eslint-plugin-coding-guide": "2.3.3",
    "@rjsf/utils": "6.11.1",
    "@rjsf/validator-ajv8": "6.11.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv-i18n": "4.2.0",
    "commitlint": "21.2.4",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "75.0.0",
    "exceljs": "4.4.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "i18next": "26.7.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "mime": "4.1.2",
    "npm-package-json-lint": "11.0.1",
    "papaparse": "5.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react-i18next": "17.1.13",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "prettier --write"
    ],
    "package.json": [
      "npmPkgJsonLint",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  }
}
